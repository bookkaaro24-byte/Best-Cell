rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for User profile
    function isValidUser(data) {
      return data.uid is string &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.email.size() <= 254 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('brandName' in data) || (data.brandName is string && data.brandName.size() <= 100)) &&
             (!('contactPhone' in data) || (data.contactPhone is string && data.contactPhone.size() <= 30)) &&
             (!('credits' in data) || data.credits is number);
    }

    // Validation for Campaign
    function isValidCampaign(data, userId) {
      return data.userId == userId &&
             data.productName is string &&
             data.productName.size() > 0 &&
             data.productName.size() <= 200;
    }

    // Validation for Inquiry
    function isValidInquiry(data, userId) {
      return data.userId == userId &&
             data.customerName is string &&
             data.customerName.size() > 0 &&
             data.customerName.size() <= 100 &&
             data.message is string &&
             data.message.size() > 0 &&
             data.message.size() <= 2000;
    }

    // User document rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && incoming().uid == existing().uid;
      allow delete: if isOwner(userId);

      // User campaigns subcollection
      match /campaigns/{campaignId} {
        allow get: if isOwner(userId) && isValidId(campaignId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(campaignId) && isValidCampaign(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(campaignId) && isValidCampaign(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(campaignId);
      }

      // User inquiries subcollection
      match /inquiries/{inquiryId} {
        allow get: if isOwner(userId) && isValidId(inquiryId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(inquiryId) && isValidInquiry(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(inquiryId) && isValidInquiry(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(inquiryId);
      }
    }
  }
}
